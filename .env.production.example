# Copy to .env on the server (next to docker-compose.prod.yml). Never commit the real file.

# The platform's domain: schools live at <slug>.PLATFORM_DOMAIN. Two labels only (asistencia.mx, not
# asistencia.com.mx): frontend/src/services/school.ts reads the school from the first label.
PLATFORM_DOMAIN=asistencia.mx
# Let's Encrypt account email (certificate expiry notices)
ACME_EMAIL=you@example.com

# Database (only reachable inside Docker). Long random password: openssl rand -base64 32
POSTGRES_USER=attendance
POSTGRES_DB=attendance
POSTGRES_PASSWORD=

# Emergency owner key for scripts: openssl rand -base64 32
SUPERADMIN_API_KEY=

# Newest gate.exe version (gates on another version show "Actualización disponible")
GATE_LATEST_VERSION=1.0.0

# WhatsApp Cloud API (RUNBOOK §8). Without the token the worker only prints messages to its log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
