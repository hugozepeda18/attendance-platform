generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id         String        @id @default(uuid())
  slug       String        @unique // subdomain: <slug>.<platform domain>
  name       String
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  config     SchoolConfig?
  students   Student[]
  teachers   Teacher[]
  subjects   Subject[]
  apiKeys    ApiKey[]
  users      User[]
  scanEvents ScanEvent[]
}

// People who sign in to a school's web page. Devices (scanners) use ApiKey instead.
model User {
  id           String             @id @default(uuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])
  email        String
  name         String
  role         Role
  passwordHash String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  sessions     Session[]
  updates      AttendanceRecord[]

  @@unique([schoolId, email])
}

// Platform owner accounts (SUPERADMIN). Not tied to any school; sign in at admin.<domain>.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// Opaque login sessions for a school User or a PlatformAdmin (exactly one is set).
// Only the sha256 of the token is stored.
model Session {
  id        String         @id @default(uuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  adminId   String?
  admin     PlatformAdmin? @relation(fields: [adminId], references: [id])
  tokenHash String         @unique
  createdAt DateTime       @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Long-lived device/service credentials (scanners, integrations). Only the sha256 hash is stored.
model ApiKey {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  role         Role
  label        String
  keyHash      String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  lastSeenAt   DateTime? // last authenticated request (scanner health)
  pendingScans Int       @default(0) // unsent scans reported by the gate's heartbeat
}

// Every gate upload, keyed by the device-generated eventId: replays return the stored result.
model ScanEvent {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  eventId       String
  credentialUid String
  scannedAt     DateTime // after clock correction; server time when clockSkew
  clockSkew     Boolean  @default(false)
  result        Json
  createdAt     DateTime @default(now())

  @@unique([schoolId, eventId])
}

enum Role {
  SCANNER
  STAFF
  PRINCIPAL
}

model SchoolConfig {
  id                   String    @id @default(uuid())
  schoolId             String    @unique
  school               School    @relation(fields: [schoolId], references: [id])
  schoolStartTime      String // HH:mm format, e.g. "08:00"
  tardyGraceMinutes    Int       @default(10)
  absenceCutoffMinutes Int       @default(30)
  timezone             String    @default("America/Mexico_City")
  dropLeadingZeros     Boolean   @default(false) // badge "0042" matches roster "42"
  absenceRunOn         DateTime? @db.Date // last school day the absence run finished
}

model Student {
  id                String             @id @default(uuid())
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id])
  credentialUid     String
  firstName         String
  lastName          String
  grade             Int
  group             String
  guardianName      String
  guardianWhatsApp  String
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, credentialUid])
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  date            DateTime         @db.Date
  scanTimestamp   DateTime?
  status          AttendanceStatus
  updatedByRole   UpdatedByRole
  updatedByUserId String?
  updatedByUser   User?            @relation(fields: [updatedByUserId], references: [id])
  note            String?

  @@unique([studentId, date])
}

enum AttendanceStatus {
  PRESENT
  TARDY
  ABSENT
  EXCUSED
}

enum UpdatedByRole {
  SYSTEM
  SCANNER
  STAFF
  PRINCIPAL
  SUPERADMIN
}

// Extensible stubs for future phases
model Teacher {
  id       String    @id @default(uuid())
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  name     String
  email    String
  subjects Subject[]

  @@unique([schoolId, email])
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  grade     Int
  group     String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}
