generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id              String              @id @default(uuid())
  slug            String              @unique // subdomain: <slug>.<platform domain>
  name            String
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  config          SchoolConfig?
  students        Student[]
  teachers        Teacher[]
  subjects        Subject[]
  apiKeys         ApiKey[]
  users           User[]
  scanEvents      ScanEvent[]
  changeRequests  ChangeRequest[]
  supportSessions Session[]
  calendarDays    SchoolCalendarDay[]
  notifications   Notification[]
  recordChanges   RecordChange[]
}

// People who sign in to a school's web page. Devices (scanners) use ApiKey instead.
model User {
  id           String             @id @default(uuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])
  email        String
  name         String
  role         Role
  passwordHash String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  sessions     Session[]
  updates      AttendanceRecord[]
  requested    ChangeRequest[]    @relation("requestedBy")
  decided      ChangeRequest[]    @relation("decidedBy")
  recordChanges RecordChange[]

  @@unique([schoolId, email])
}

// Platform owner accounts (SUPERADMIN). Not tied to any school; sign in at admin.<domain>.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// Opaque login sessions for a school User or a PlatformAdmin (exactly one is set).
// Only the sha256 of the token is stored.
model Session {
  id        String         @id @default(uuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  adminId   String?
  admin     PlatformAdmin? @relation(fields: [adminId], references: [id])
  tokenHash String         @unique
  schoolId  String? // admin support session: locked to this one school, no platform admin rights
  school    School?        @relation(fields: [schoolId], references: [id])
  createdAt DateTime       @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Long-lived device/service credentials (scanners, integrations). Only the sha256 hash is stored.
model ApiKey {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  role         Role
  label        String
  keyHash      String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  lastSeenAt   DateTime? // last authenticated request (scanner health)
  pendingScans Int       @default(0) // unsent scans reported by the gate's heartbeat
}

// Every gate upload, keyed by the device-generated eventId: replays return the stored result.
model ScanEvent {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  eventId       String
  credentialUid String
  scannedAt     DateTime // after clock correction; server time when clockSkew
  clockSkew     Boolean  @default(false)
  result        Json
  createdAt     DateTime @default(now())

  @@unique([schoolId, eventId])
}

enum Role {
  SCANNER
  STAFF
  PRINCIPAL
}

model SchoolConfig {
  id                   String    @id @default(uuid())
  schoolId             String    @unique
  school               School    @relation(fields: [schoolId], references: [id])
  schoolStartTime      String // HH:mm format, e.g. "08:00"
  tardyGraceMinutes    Int       @default(10)
  absenceCutoffMinutes Int       @default(30)
  timezone             String    @default("America/Mexico_City")
  dropLeadingZeros     Boolean   @default(false) // badge "0042" matches roster "42"
  absenceRunOn         DateTime? @db.Date // last school day the absence run finished
  principalWhatsApp    String? // WhatsApp alerts for the principal (gate not synced at the cutoff, new change requests)
}

model Student {
  id                String             @id @default(uuid())
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id])
  credentialUid     String
  firstName         String
  lastName          String
  grade             Int
  group             String
  guardianName      String
  guardianWhatsApp  String
  active            Boolean            @default(true) // withdrawn: no scans, no absence run, hidden from lists
  whatsappOptOut    Boolean            @default(false) // guardian asked for no WhatsApp messages (privacy notice)
  attendanceRecords AttendanceRecord[]
  changeRequests    ChangeRequest[]

  @@unique([schoolId, credentialUid])
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  date            DateTime         @db.Date
  scanTimestamp   DateTime?
  status          AttendanceStatus
  updatedByRole   UpdatedByRole
  updatedByUserId String?
  updatedByUser   User?            @relation(fields: [updatedByUserId], references: [id])
  note            String?
  notifications   Notification[]
  changes         RecordChange[]

  @@unique([studentId, date])
}

// Audit trail: one row per insert and per status/note change of an AttendanceRecord. Written by a
// Postgres trigger (migration record_audit_trail), so every path (scan, absence run, excuse, override,
// approved request, createMany) is covered without app code. `at` is the database clock.
model RecordChange {
  id         String            @id @default(uuid())
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id])
  recordId   String
  record     AttendanceRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fromStatus AttendanceStatus? // null = record created
  toStatus   AttendanceStatus
  note       String?
  byRole     UpdatedByRole
  byUserId   String?
  byUser     User?             @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  at         DateTime          @default(now())

  @@index([recordId, at])
}

// WhatsApp outbox. Scans and the absence run only insert rows (in the same write as the record);
// the worker (src/worker.ts) sends them. One message per record and type: gate retries and worker
// restarts cannot send twice. Merged siblings share the providerId of the message that carried them.
model Notification {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  recordId      String?
  record        AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type          MessageType
  template      String // Meta template name (src/services/templates.ts)
  phone         String // E.164
  params        Json // template parameters after the school name, in order
  eventAt       DateTime // when it happened; entry messages older than 2 h are not sent
  status        MessageStatus     @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now()) // also the lease while SENDING (a crashed worker's rows come back)
  lastError     String?
  providerId    String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())

  @@unique([recordId, type])
  @@index([status, nextAttemptAt])
  @@index([providerId])
}

enum MessageType {
  ENTRY
  ABSENCE
  PRINCIPAL_ALERT
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  EXPIRED
}

// The school's own days without classes (suspensión, school anniversary), on top of the SEP calendar
// (src/calendar/sep.ts). The absence run and excuses skip them.
model SchoolCalendarDay {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  date      DateTime @db.Date
  label     String
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
}

// Staff ask the principal to change a day's status (e.g. "llegó 9:10 con su mamá" → TARDY).
// Nothing changes until the principal approves; the guardian is never messaged about it.
model ChangeRequest {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  date          DateTime          @db.Date
  fromStatus    AttendanceStatus? // status when requested; null = no record that day yet
  toStatus      AttendanceStatus
  reason        String
  requestedById String
  requestedBy   User              @relation("requestedBy", fields: [requestedById], references: [id])
  state         RequestState      @default(PENDING)
  decidedById   String?
  decidedBy     User?             @relation("decidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([schoolId, state])
}

enum RequestState {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  TARDY
  ABSENT
  EXCUSED
}

enum UpdatedByRole {
  SYSTEM
  SCANNER
  STAFF
  PRINCIPAL
  SUPERADMIN
}

// Extensible stubs for future phases
model Teacher {
  id       String    @id @default(uuid())
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  name     String
  email    String
  subjects Subject[]

  @@unique([schoolId, email])
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  grade     Int
  group     String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}
