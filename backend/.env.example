DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db"
PORT=4000
NODE_ENV=development
# Platform owner key. Use a long random value in production: openssl rand -base64 32
SUPERADMIN_API_KEY="ak_dev_superadmin"
# Version of the newest gate.exe; gates on another version show "Actualización disponible"
# GATE_LATEST_VERSION="1.0.0"
# WhatsApp Cloud API (Meta). Without them the worker (npm run worker) only prints messages.
# WHATSAPP_TOKEN=""            # permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=""  # the platform's number, from WhatsApp Manager → API setup
# WHATSAPP_APP_SECRET=""       # App settings → Basic; checks delivery webhook signatures
# WHATSAPP_VERIFY_TOKEN=""     # any random string, also typed into the webhook configuration
